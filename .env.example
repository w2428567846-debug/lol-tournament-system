NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Canonical origin only. Use the final HTTPS domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_FEATURED_TOURNAMENT_SLUG=community-cup-08
# Opt in only for development/testing or the documented controlled closed beta.
ENABLE_EMAIL_DEV_AUTH=false

# Optional until real WeChat OAuth exists. Server-only; never prefix with NEXT_PUBLIC_.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_OAUTH_REDIRECT_URI=
